# ─── Secrets & Config ────────────────────────────────────────
.env
secrets/

# ─── Models (large binary files) ─────────────────────────────
models/*.gguf
models/*.bin
models/*.safetensors

# ─── Java ────────────────────────────────────────────────────
**/target/
**/.gradle/
**/build/
**/*.class
**/*.jar
**/*.war
**/.idea/
**/*.iml
**/out/

# ─── Python ──────────────────────────────────────────────────
**/__pycache__/
**/*.pyc
**/*.pyo
**/.venv/
**/venv/
**/.env
**/*.egg-info/
**/dist/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# ─── Node / React ────────────────────────────────────────────
**/node_modules/
**/dist/
**/.next/
**/.vite/

# ─── Docker volumes (local dev) ──────────────────────────────
.docker-volumes/

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/

# ─── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Keys & Temps ────────────────────────────────────────
# Private keys belong in ./secrets/ (ignored above), not loose in the tree.
# These patterns stay as a backstop for a key that lands somewhere else by
# accident — but a backstop is not a place to keep one: an ignored file is
# still on disk, still readable by anything running as this user, and still
# picked up by backups and editor plugins.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*.txt
*.pid
*.log
*.log*
*.gz
