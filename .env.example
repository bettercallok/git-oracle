# ============================================================
# GitOracle — Environment Variables
# Copy this file to .env and fill in your values
# 
# ============================================================

# ─── API Authentication ───────────────────────────────────────
# LEGACY single shared key. It authenticates as the DEFAULT tenant with the
# platform:admin scope, which means it can read and mutate every tenant's data
# — it is not multi-tenant authentication and must not be used in production.
#
# ./start_local.sh replaces this placeholder with a random key (find it here
# afterwards), and every service refuses to start on a placeholder.
#
# It survives only to bootstrap the first real key without locking you out:
#   1. curl -H "X-API-Key: $GITORACLE_API_KEY" -X POST \
#        http://localhost:8080/api/v1/admin/api-keys \
#        -H 'Content-Type: application/json' \
#        -d '{"name":"dashboard","tenantId":"<your tenant uuid>"}'
#   2. Save the returned gor_..._... key — it is shown exactly once.
#   3. Set GITORACLE_LEGACY_API_KEY_ENABLED=false and restart the gateway.
# The gateway logs a warning on every boot while this is enabled.
GITORACLE_API_KEY=change_me_secret_api_key

# Repositories the default tenant may use (owner/name or GitHub URL, comma-separated).
# Every job, PR target, commit-explorer read and risk query is checked against the
# caller tenant's allow-list; an empty list allows nothing. Other tenants' lists:
# POST/DELETE /api/v1/admin/repos.
GITORACLE_ALLOWED_REPOS=

# Set to false once real per-tenant keys have been issued (see above).
GITORACLE_LEGACY_API_KEY_ENABLED=true

# How long the gateway caches an api_keys row before re-reading it. This is
# also how long a REVOKED key remains usable, so it is a direct trade between
# database load and revocation latency. 0 disables caching (a DB read per
# request, revocation effective immediately).
GITORACLE_API_KEY_CACHE_TTL_SECONDS=60

# Shared secret every internal service (all 6 Java services, all 7 Python
# agents) requires on the X-Internal-Token header before serving a request.
# api-gateway is the only service that DOESN'T require it on inbound
# requests — it injects this value itself once a request has already passed
# X-API-Key/tenant validation, so callers behind the gateway never need to
# know it. Generate with: openssl rand -hex 32
# ./start_local.sh replaces this placeholder with a random value.
GITORACLE_INTERNAL_TOKEN=change_me_internal_service_token

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
# Host port. 5433, matching every service's default and docker-compose.infra.yml,
# so it doesn't collide with a local Postgres on 5432.
POSTGRES_PORT=5433
POSTGRES_DB=gitOracle
POSTGRES_USER=gitOracle
POSTGRES_PASSWORD=change_me_strong_password

# ─── Neo4j ───────────────────────────────────────────────────
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7474
# Host port compose publishes Bolt on. git-forensics connects to NEO4J_PORT,
# defaulting to 7688, so this must stay 7688 unless you set NEO4J_PORT to match.
# (It was 7687 here, so a fresh .env left git-forensics unable to reach Neo4j.)
NEO4J_BOLT_PORT=7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_strong_password
NEO4J_AUTH=neo4j/change_me_strong_password

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_password

# ─── Qdrant ──────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Required — Qdrant has no auth at all when this is unset. Generate with:
# openssl rand -hex 32
QDRANT_API_KEY=change_me_qdrant_api_key

# ─── Kafka ───────────────────────────────────────────────────
KAFKA_HOST=localhost
KAFKA_PORT=9092

# Kafka's host listener (localhost:9092) requires SASL/PLAIN: it used to accept
# anyone, so any local process could publish job events. start_local.sh
# generates KAFKA_SASL_PASSWORD on first run and connects with it; set it
# yourself before `make infra-up`. Containers use the internal listener.
KAFKA_SASL_USERNAME=gitoracle
KAFKA_SASL_PASSWORD=
KAFKA_INTERNAL_PORT=9093
# For connecting from host machine
KAFKA_EXTERNAL_HOST=localhost

# ─── Langfuse (LLM Observability) ────────────────────────────
LANGFUSE_HOST=localhost
LANGFUSE_PORT=3002
LANGFUSE_DB=langfuse
LANGFUSE_NEXTAUTH_URL=http://localhost:3002
LANGFUSE_NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
LANGFUSE_SALT=generate_with_openssl_rand_base64_32
# Get these after first Langfuse login at http://localhost:3002
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ─── Prometheus ──────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ─── Grafana ─────────────────────────────────────────────────
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# ─── LLM API Configuration ─────────────────────────────────────
# Any OpenAI-compatible endpoint. These are the names the agents actually read
# (shared/structured_output.py) — this file used to say LLM_API_KEY / LLM_MODEL,
# which nothing reads, so a fresh .env silently ran keyless on the default model.
# LLM_BASE_URL is the FULL chat-completions URL, not the API root.
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=your_api_key_here
LLM_MODEL_NAME=gpt-4o-mini
LLM_CTX_SIZE=8192

# ─── Agent memory (embeddings) ──────────────────────────────────────────────
# Separate from the chat model above: any OpenAI-compatible embeddings endpoint
# (FULL URL). Leave EMBEDDINGS_BASE_URL empty to turn agent memory off — nothing
# runs inside the agents either way. Examples:
#   Ollama (local):    http://localhost:11434/v1/embeddings   model: all-minilm (384-d, ideal)
#   LM Studio (local): http://localhost:1234/v1/embeddings
#   OpenAI:            https://api.openai.com/v1/embeddings   model: text-embedding-3-small
# Groq has no embeddings endpoint. Vectors are stored at 384 dimensions (larger
# ones are truncated); a 384-d or Matryoshka model (nomic-embed-text,
# text-embedding-3-*) works best. Changing model starts memory afresh.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=

# ─── GitHub App ──────────────────────────────────────────────
# Read by github-bot and the orchestrator (GitHubAppCredentials). This is the
# one place they belong — java-backend/github-bot/.env still works but is
# deprecated. Left empty on purpose: a placeholder that looks like a value is
# what used to shadow real credentials. Empty = no GitHub App (PRs can't open).
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=

# The GitHub App private key. Keep it in ./secrets/ (gitignored, mode 0700)
# and the key itself mode 0600 — NEVER loose in the repo root, where a stray
# `git add -A`, a backup tool, or an editor plugin can pick it up.
#
# It must be PKCS#8 ("-----BEGIN PRIVATE KEY-----"). GitHub hands you PKCS#1
# ("-----BEGIN RSA PRIVATE KEY-----"), which the Java loader cannot read — it
# uses PKCS8EncodedKeySpec. Convert once:
#
#   openssl pkcs8 -topk8 -nocrypt \
#     -in  ./secrets/github-app.pkcs1-original.pem \
#     -out ./secrets/github-app.pem
#   chmod 600 ./secrets/github-app.pem
#
# A relative path is relative to the repo root: start_local.sh makes it
# absolute before launching services (they run from java-backend/).
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Must match the webhook secret configured on the GitHub App itself
# (GitHub App settings → Webhook → Secret) — WebhookController verifies
# every /webhook/github delivery's X-Hub-Signature-256 against this.
# Blank or a placeholder rejects every delivery. Generate with: openssl rand -hex 32
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=your_client_id
GITHUB_APP_CLIENT_SECRET=your_client_secret
# The App's URL name, from github.com/apps/<slug>, so owners can connect their
# organisations. In the App's settings, set the Setup URL to
# <GITORACLE_PUBLIC_API_URL>/api/v1/auth/github/setup, tick "Redirect on update",
# and allow it to be installed on any account.
GITHUB_APP_SLUG=

# ─── Sign in with GitHub ─────────────────────────────────────
# Uses the client id and secret above. In the GitHub App's settings, set the
# Callback URL to <GITORACLE_PUBLIC_API_URL>/api/v1/auth/github/callback.
# Without them the login page offers API keys only.
#
# The URLs people reach. An https public API URL makes the cookies Secure.
GITORACLE_PUBLIC_API_URL=http://localhost:8080
GITORACLE_DASHBOARD_URL=http://localhost:5173
# Who may sign in without an invitation. Organisations invite everyone else from
# the API (POST /api/v1/org/invitations). Changes here apply at the next
# orchestrator restart, which also ends the access these lists gave.
# Each listed login (comma-separated) gets an organisation of their own, empty
# until a platform admin adds repositories with POST /api/v1/admin/repos.
GITORACLE_INVITED_GITHUB_USERS=
# Platform admins run the whole system and own the default organisation. Numeric GitHub ids, not
# logins, because a released login can be claimed by someone else. Find yours at
# https://api.github.com/users/<login> ("id").
GITORACLE_ADMIN_GITHUB_IDS=
# What an organisation may use per calendar month, unless a platform admin sets its
# own with PUT /api/v1/admin/tenants/{id}/limits. 0 means no limit. The default
# organisation has no limit unless one is set.
GITORACLE_ORG_MONTHLY_JOBS=50
GITORACLE_ORG_MONTHLY_TOKENS=5000000
# How long a sign-in lasts (ISO-8601 duration).
GITORACLE_SESSION_TTL=P7D
# Origins allowed to call the API: the dashboard's. Must not be "*", since the
# session cookie is sent with these calls.
GITORACLE_ALLOWED_ORIGINS=http://localhost:5173

# ─── Sentry Webhook ──────────────────────────────────────────
# Shared secret for /webhook/{tenantId}/sentry — WebhookController verifies
# X-Sentry-Signature (HMAC-SHA256 of the raw body) against this before
# acting on the payload. Blank or a placeholder rejects every delivery.
# Generate with: openssl rand -hex 32
SENTRY_WEBHOOK_SECRET=

# ─── Spring Boot Services ─────────────────────────────────────
API_GATEWAY_PORT=8080
ERROR_INGESTOR_PORT=8081
GIT_FORENSICS_PORT=8082
ORCHESTRATOR_PORT=8083
TEST_RUNNER_PORT=8084
GITHUB_BOT_PORT=8085

# ─── Python AI Agents ─────────────────────────────────────────
INVESTIGATOR_PORT=9001
FIXER_PORT=9002
REVIEWER_PORT=9003
COMMIT_ANALYST_PORT=9004
PROMPT_REGISTRY_PORT=9005
GUARDRAILS_PORT=9006
PLANNER_PORT=9007

# ─── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
JWT_SECRET=generate_with_openssl_rand_base64_64
JWT_EXPIRY_HOURS=24
DEFAULT_TOKEN_BUDGET=50000
CAUSAL_CONFIDENCE_THRESHOLD=0.6
MAX_FIX_ATTEMPTS=5
TEST_TIMEOUT_SECONDS=120
