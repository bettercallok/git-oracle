# Copy to site.env. Not secret, but specific to your deployment.
GITORACLE_PUBLIC_HOST=gitoracle.example.com
GITORACLE_PUBLIC_API_URL=https://gitoracle.example.com
GITORACLE_DASHBOARD_URL=https://gitoracle.example.com
GITORACLE_ALLOWED_ORIGINS=https://gitoracle.example.com
# owner/name, comma-separated: the default organisation's repositories.
GITORACLE_ALLOWED_REPOS=
# Numeric GitHub ids of platform admins, and logins who may sign in.
GITORACLE_ADMIN_GITHUB_IDS=
GITORACLE_INVITED_GITHUB_USERS=
GITHUB_APP_SLUG=
# Any OpenAI-compatible endpoint: the full /chat/completions URL.
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL_NAME=
# Optional: agent memory is off without it.
EMBEDDINGS_BASE_URL=
