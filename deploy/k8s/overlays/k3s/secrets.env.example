# Copy to secrets.env and fill in. Never commit it (.gitignore covers it).
# Generate the random ones with: openssl rand -hex 32
GITORACLE_INTERNAL_TOKEN=
# Only to mint the first real key (scripts/setup_production_config.sh); the
# config turns the legacy key off, so this may stay a long random value.
GITORACLE_API_KEY=
POSTGRES_PASSWORD=
KAFKA_SASL_PASSWORD=
NEO4J_PASSWORD=
# Must be neo4j/<NEO4J_PASSWORD>.
NEO4J_AUTH=
REDIS_PASSWORD=
QDRANT_API_KEY=
# The LLM provider's key. Sent to LLM_BASE_URL only.
OPENAI_API_KEY=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
SENTRY_WEBHOOK_SECRET=
